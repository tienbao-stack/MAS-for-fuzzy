# Provider: openai, gemini, openrouter, or ollama
LLM_PROVIDER=ollama
# Ollama only: local or cloud
LLM_MODE=local
# Optional common model override. Leave blank to use the selected provider's model below.
LLM_MODEL=
# Optional endpoint override. For Ollama Cloud through a locally signed-in Ollama server,
# use http://localhost:11434/v1 and set LLM_MODEL=gemma4:cloud.
LLM_BASE_URL=

# Set only the key for the selected remote provider. Local Ollama needs no API key.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Optional provider-specific model names. LLM_MODEL takes precedence.
OPENAI_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
OLLAMA_LOCAL_MODEL=qwen3-vl:4b-instruct
OLLAMA_CLOUD_MODEL=
